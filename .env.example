# Runtime connection. In production use Neon's pooled connection string.
DATABASE_URL=postgres://bakeryos:bakeryos@localhost:5432/bakeryos
# Direct (unpooled) connection used by Drizzle Kit for migrations. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=postgres://bakeryos:bakeryos@localhost:5432/bakeryos

# Auth.js session secret. Generate with: openssl rand -base64 32
AUTH_SECRET=
# HMAC secret for deriving reservation management tokens. Generate with: openssl rand -base64 32
MANAGEMENT_TOKEN_SECRET=

# Administrator created by the seed script.
ADMIN_SEED_EMAIL=admin@bakeryos.local
ADMIN_SEED_PASSWORD=
