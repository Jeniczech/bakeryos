{
    "name": "bakeryos",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "typecheck": "next typegen && tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run --project unit",
        "test:watch": "vitest --project unit",
        "test:integration": "vitest run --project integration",
        "db:up": "docker compose up -d --wait postgres",
        "db:down": "docker compose down",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:migrate:prod": "node --env-file=.env.neon node_modules/drizzle-kit/bin.cjs migrate",
        "db:seed": "node --env-file-if-exists=.env scripts/seed.ts",
        "db:seed:prod": "node --env-file=.env.neon scripts/seed.ts",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@node-rs/argon2": "2.2.2",
        "drizzle-orm": "0.45.4",
        "next": "16.4.6",
        "next-auth": "5.0.0-beta.32",
        "pg": "8.23.1",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "sonner": "2.0.8",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@playwright/test": "^1.65.1",
        "@tailwindcss/turbopack": "4.3.3",
        "@types/node": "^24",
        "@types/pg": "8.23.1",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "drizzle-kit": "0.31.11",
        "eslint": "^9",
        "eslint-config-next": "16.4.6",
        "eslint-config-prettier": "10.1.8",
        "prettier": "3.10.1",
        "prettier-plugin-tailwindcss": "0.8.1",
        "tailwindcss": "4.3.3",
        "typescript": "^5",
        "vitest": "5.1.1"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@10.33.0"
}
